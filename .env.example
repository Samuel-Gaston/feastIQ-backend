# BCRYPT
BCRYPT_SALT_ROUNDS=10

# MAILHOST
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_google_app_password

# AI/ML
AI_SERVICE_BASE_URL=http://localhost:8000

# LLM API
OPENAI_API_KEY=gsk_your_groq_api_key_here