<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
</head>
<body style="margin: 0; padding: 0; background: #F9FAFB; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', 'Liberation Sans', sans-serif; color: #111827; -webkit-text-size-adjust: 100%;">
<div style="width: 100%; padding: 12px; box-sizing: border-box; display: flex; justify-content: center;">
  <div style="width: 100%; max-width: 720px; background: #FFFFFF; border-radius: 12px; overflow: hidden; box-shadow: 0 6px 18px rgba(16, 24, 40, 0.06);">
    <div style="padding: 18px 14px; text-align: center; background: linear-gradient(180deg, #FFF7ED 0%, #ffffff 60%); border-bottom: 1px solid rgba(15, 23, 42, 0.03);">
      <div style="margin: 0 auto 26px;">
        <img src="https://nufisms.com/assets/images/dark.png" alt="{{appName}}" style="display: inline-block; margin: 0 auto 26px; height: 44px; width: auto;" />
      </div>
      <h1 style="font-size: 20px; margin: 6px 0 4px; line-height: 1.15; font-weight: 700;">
        {{t "EMAIL_WELCOME_TITLE"}}<br />
        <span style="background: linear-gradient(90deg, #F97316, #EC4899, #A855F7); -webkit-background-clip: text; background-clip: text; color: transparent;">{{appName}}</span>
      </h1>
      <p style="margin: 0; color: #6B7280; font-size: 13px; line-height: 1.4; max-width: 460px; margin-left: auto; margin-right: auto;">
        {{t "EMAIL_ACCOUNT_CREATED_DESC"}}
      </p>
    </div>

    <div style="padding: 16px;">
      <div style="font-size: 14px; color: #6B7280; text-align: center; margin-bottom: 12px;">
        <p style="margin: 0; color: #111827; font-weight: 600;">{{t "EMAIL_HELLO"}}, <span style="color: #111827; font-weight: 600;">{{userName}}</span>,</p>
        <p>{{t "EMAIL_WELCOME_MESSAGE"}}</p>
      </div>

      <div style="background: #FFF7ED; border: 1px solid rgba(254, 215, 170, 0.6); border-radius: 12px; padding: 14px; text-align: center; margin-bottom: 12px;">
        <h2 style="font-weight: 700; font-size: 16px; margin-bottom: 6px;">{{t "EMAIL_CREDENTIALS_TITLE"}}</h2>
        <p>{{t "EMAIL_CREDENTIALS_DESC"}}</p>
        <p style="margin: 6px 0; color: #6B7280; font-size: 13px;">
          Email : <span style="color: #111827; font-weight: 600;">{{userEmail}}</span><br />
          {{t "EMAIL_PASSWORD"}} : <span style="color: #111827; font-weight: 600;">{{generatedPassword}}</span>
        </p>
      </div>

      <div style="background: #FFF7ED; border: 1px solid rgba(254, 215, 170, 0.6); border-radius: 12px; padding: 14px; text-align: center; margin-bottom: 12px;">
        <h2 style="font-weight: 700; font-size: 16px; margin-bottom: 6px;">{{t "EMAIL_ACTIVATE_ACCOUNT_TITLE"}}</h2>
        <p>{{t "EMAIL_ACTIVATE_ACCOUNT_DESC"}}</p>
        <a href="{{activationLink}}" style="display: inline-block; padding: 10px 14px; background: #F97316; color: #fff; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 14px; box-shadow: 0 8px 24px rgba(249, 115, 22, 0.16);">{{t "EMAIL_ACTIVATE_ACCOUNT_BUTTON"}}</a>
        <p style="margin-top:16px; word-break: break-all;">
          {{t "EMAIL_DIRECT_LINK"}} : <a href="{{activationLink}}" style="color: #6B7280; text-decoration: underline; font-size: 12px;">{{activationLink}}</a>
        </p>
        <p style="font-size: 12px; color: #9CA3AF; margin-top: 8px; text-align: center;">{{t "EMAIL_LINK_EXPIRES"}}</p>
      </div>

      <div style="padding: 10px 0;">
        <h2 style="font-weight: 700; font-size: 16px; margin-bottom: 6px; text-align: center;">{{t "EMAIL_WHAT_TO_EXPECT"}}</h2>
        <p style="color: #6B7280; font-size: 13px; text-align: center; margin: 0 auto; max-width: 460px;">{{t "EMAIL_FEATURES_SUBTITLE"}}</p>
      </div>

  </div>
    <footer style="background-color: #030712;color: #6B7280;font-size: 11px;padding: 32px;text-align: center;">
      © {{year}} {{appName}} — {{t "EMAIL_FOOTER_ALL_RIGHTS_RESERVED"}}
    </footer>
</div>
</body>
</html>
